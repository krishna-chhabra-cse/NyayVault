{
  "name": "nyayvault",
  "version": "1.0.0",
  "description": "NyayVault: cloud-native digital evidence vault on AWS (EC2 + S3)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "test:e2e": "cd server && npm run test:e2e"
  },
  "keywords": [
    "evidence-management",
    "aws",
    "ec2",
    "s3",
    "chain-of-custody",
    "sha256"
  ],
  "author": "NyayVault Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
